generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("amigurumi")
  status        String   @default("not_started")
  description   String   @default("")
  coverImage    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Amigurumi fields
  patternText   String   @default("")
  pdfPath       String?
  currentLine   Int      @default(0)
  recipe        String   @default("{}")

  // Tapestry fields
  pixelWidth    Int?
  pixelHeight   Int?
  pixelData     String?
  originalImage String?
  currentRow    Int      @default(0)

  // Timer (in seconds)
  timerSeconds  Int      @default(0)

  rows  ProjectRow[]
}

model ProjectRow {
  id        String @id @default(cuid())
  projectId String
  rowIndex  Int
  rowData   String @default("")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, rowIndex])
}

model SiteConfig {
  id   String  @id @default("default")
  icon String?
}
